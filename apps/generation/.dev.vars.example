# Copy to apps/generation/.dev.vars and replace each local model id with one
# installed in LM Studio. This active block is the only default strategy.
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
MODEL_CONFIG='{"main_story":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20}},"announcements":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20}},"packaging":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20}}}'

# Hosted alternative: first comment every assignment in the local block above,
# then uncomment every assignment below. Replace both zero rate placeholders
# with the provider's published per-million-token rates. Never commit the secret.
# HOSTED_MODEL_BASE_URL="https://provider.example/v1"
# HOSTED_MODEL_API_KEY="replace-with-local-secret"
# MODEL_CONFIG='{"main_story":{"adapter":"openai_compatible_hosted","provider":"replace-with-provider-id","model":"replace-with-model-id","billing":{"method":"calculated","input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0,"pricing_reference":"replace-with-public-pricing-url-or-version"}},"announcements":{"adapter":"openai_compatible_hosted","provider":"replace-with-provider-id","model":"replace-with-model-id","billing":{"method":"calculated","input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0,"pricing_reference":"replace-with-public-pricing-url-or-version"}},"packaging":{"adapter":"openai_compatible_hosted","provider":"replace-with-provider-id","model":"replace-with-model-id","billing":{"method":"calculated","input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0,"pricing_reference":"replace-with-public-pricing-url-or-version"}}}'
