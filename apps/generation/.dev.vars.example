# Required for local calls to the generation launch and operator status routes.
# Generate a dedicated random value and never commit the populated .dev.vars file.
OPERATOR_API_TOKEN="replace-with-random-operator-token"

# Copy to apps/generation/.dev.vars and replace each local model id with one
# installed in LM Studio. Each writer is configured independently; they may
# intentionally use the same model. Set `temperature`, `top_p`, `top_k`, and
# `enable_thinking` only to values selected for that model; omitting any one
# field keeps that field on its provider default. The generation Worker has no
# copyedit, packaging, or judge model slot.
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
MODEL_CONFIG='{"main_story_write":{"adapter":"lmstudio","model":"replace-with-local-model-id","temperature":0.7,"top_p":0.95,"top_k":20,"enable_thinking":false,"reasoning_effort":"provider_default"},"announcements_write":{"adapter":"lmstudio","model":"replace-with-local-model-id","temperature":0.7,"top_p":0.95,"top_k":20,"enable_thinking":false,"reasoning_effort":"provider_default"}}'

# Hosted alternative: comment the local block above, uncomment this block,
# replace all placeholders, and never commit the secret.
# HOSTED_MODEL_BASE_URL="https://provider.example/v1"
# HOSTED_MODEL_API_KEY="replace-with-local-secret"
# MODEL_CONFIG='{"main_story_write":{"adapter":"openai_compatible_hosted","provider":"replace-with-provider-id","model":"replace-with-model-id","billing":{"method":"calculated","input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0,"pricing_reference":"replace-with-public-pricing-url-or-version"}},"announcements_write":{"adapter":"openai_compatible_hosted","provider":"replace-with-provider-id","model":"replace-with-model-id","billing":{"method":"calculated","input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0,"pricing_reference":"replace-with-public-pricing-url-or-version"}}}'

# Cloudflare AI Gateway REST production selection: the token needs Account >
# Workers AI > Read. Unified Billing supplies third-party provider credentials.
# Keep these values only in the ignored .dev.vars file; deployment secret
# installation is a separate operator action.
# CF_ACCOUNT_ID="replace-with-account-id"
# CF_AI_GATEWAY_API_TOKEN="replace-with-workers-ai-read-token"
# MODEL_CONFIG='{"main_story_write":{"adapter":"cloudflare_ai_gateway","model":"google/gemini-3.1-flash-lite"},"announcements_write":{"adapter":"cloudflare_ai_gateway","model":"google/gemini-3.1-flash-lite"}}'
