# Copy to apps/generation/.dev.vars and replace each local model id with one
# installed in LM Studio. Each production step is configured independently;
# they may intentionally use the same model. The generation Worker has no
# packaging or judge model slot.
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
MODEL_CONFIG='{"main_story_write":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20},"reasoning_effort":"none"},"main_story_copyedit":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20},"reasoning_effort":"none"},"announcements_write":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20},"reasoning_effort":"none"},"announcements_copyedit":{"adapter":"lmstudio","model":"replace-with-local-model-id","sampling":{"temperature":1,"top_p":0.95,"top_k":20},"reasoning_effort":"none"}}'

