{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bc-news-generation-client",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"secrets": {
		"required": ["CF_AI_GATEWAY_API_TOKEN", "OPERATOR_API_TOKEN"]
	},
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	"workflows": [
		{
			"name": "generation-run",
			"binding": "GENERATION_RUN",
			"class_name": "GenerationRun"
		}
	],
	"ratelimits": [
		{
			"name": "EDITION_API_RATE_LIMITER",
			"namespace_id": "262667397",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bc-news-editions",
			// Ingest writes chat evidence here; generation publishes editions to the same database.
			"database_id": "5192d247-216a-4ee1-a4db-0d6394a916c7",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": "../client/dist"
	},
	"vars": {
		"BITJITA_API_BASE": "https://bitjita.com",
		"EVIDENCE_INPUT": "d1_chat",
		"MODEL_CONFIG": "{\"main_story_write\":{\"adapter\":\"cloudflare_ai_gateway\",\"model\":\"google/gemini-3.1-flash-lite\"},\"announcements_write\":{\"adapter\":\"cloudflare_ai_gateway\",\"model\":\"google/gemini-3.1-flash-lite\"}}"
	}
}
