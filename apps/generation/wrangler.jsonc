{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bc-news-generation",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	"workflows": [
		{
			"name": "generation-run",
			"binding": "GENERATION_RUN",
			"class_name": "GenerationRun"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bc-news-editions",
			// Local emulation keys storage by this id; replaced by the real id when
			// the user provisions the production database (user-led, out of scope).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": "../client/dist"
	},
	"vars": {
		"EVIDENCE_INPUT": "d1_chat",
		"MODEL_CONFIG": "{\"main_story_write\":{\"adapter\":\"recorded\"},\"main_story_copyedit\":{\"adapter\":\"recorded\"},\"announcements_write\":{\"adapter\":\"recorded\"},\"announcements_copyedit\":{\"adapter\":\"recorded\"}}"
	}
}
