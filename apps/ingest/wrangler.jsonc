{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bc-news-ingestion-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bc-news-editions",
			// Ingest writes chat evidence and cursor state here; generation owns the
			// shared migration chain.
			"database_id": "5192d247-216a-4ee1-a4db-0d6394a916c7"
		}
	],
	"vars": {
		"POLL_LIMIT": "100",
		"POLL_OVERLAP_SECONDS": "10",
		"POLL_CURSOR_KEY": "chat_firehose",
		"BITJITA_API_BASE": "https://bitjita.com"
	}
}
