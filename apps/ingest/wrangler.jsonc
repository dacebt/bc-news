{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bc-news-v2-ingest",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-03",
	"workers_dev": false,
	"preview_urls": false,
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bc-news-editions",
			// Same database as apps/generation — one D1 database holds edition,
			// chat_messages, and poll_state. No migrations_dir here: the migration
			// chain lives solely in apps/generation/migrations, one owner for a
			// serial resource.
			"database_id": "5192d247-216a-4ee1-a4db-0d6394a916c7"
		}
	],
	"vars": {
		"POLL_LIMIT": "100",
		"POLL_OVERLAP_SECONDS": "10",
		"POLL_CURSOR_KEY": "chat_firehose",
		"BITJITA_API_BASE": "https://bitjita.com"
	}
}
